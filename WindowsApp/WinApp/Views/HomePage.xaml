<Page
    x:Class="LeftHandDevice.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LeftHandDevice.Views"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <views:PageScrollHost x:Name="ScrollHost">
        <Grid x:Name="ContentArea"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top">
            <StackPanel Style="{StaticResource PageBaseStackPanelStyle}">
                <TextBlock x:Uid="Page_Home" Style="{StaticResource PageTitleTextStyle}" />

                <!-- COM 接続ヘッダー -->
                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE964;" FontSize="22" VerticalAlignment="Center" />
                            <TextBlock Text="Pico W 2 接続状態"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox x:Name="ComPortComboBox"
                                  Grid.Column="1"
                                  Width="150"
                                  Margin="0,0,12,0"
                                  PlaceholderText="COMポート"
                                  VerticalAlignment="Center" />
                        <Button x:Name="ConnectButton"
                                Grid.Column="2"
                                Content="接続する"
                                MinWidth="100"
                                Click="ConnectButton_Click" />
                    </Grid>
                </Border>

                <!-- アクション行 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <Button x:Name="AddPatternButton"
                            Content="＋ パターン追加"
                            Click="AddPatternButton_Click" />
                    <Button x:Name="SyncAllButton"
                            Content="すべてマイコンへ保存"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SyncAllButton_Click" />
                    <TextBlock x:Name="ActiveButtonsText"
                               Text="有効ボタン数: 5"
                               VerticalAlignment="Center"
                               Opacity="0.7" />
                </StackPanel>

                <!-- パターン一覧（幅は PageBaseStackPanelStyle の MaxWidth に合わせる） -->
                <StackPanel x:Name="PatternsConfigPanel" Spacing="12" />
            </StackPanel>

            <!-- 連続動作警告オーバーレイ -->
            <Border x:Name="ContinuousWarningOverlay"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="#88000000"
                    Visibility="Collapsed">
                <TextBlock Text="連続動作中です！"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White" />
            </Border>
        </Grid>
    </views:PageScrollHost>
</Page>
